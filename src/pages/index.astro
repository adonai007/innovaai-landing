---
const target = 'https://innovai.click/es/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>InnovaAI</title>
    {/* English browsers go to /en/; everyone else, and every visitor without JS, to the Spanish default */}
    <script is:inline>window.location.replace(/^en\b/i.test(navigator.language || '') ? '/en/' : '/es/');</script>
  </head>
  <body><a href={target}>InnovaAI</a></body>
</html>
