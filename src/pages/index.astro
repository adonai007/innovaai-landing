---
const target = 'https://innovai.click/es/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>InnovaAI</title>
    <script is:inline>window.location.replace('/es/');</script>
  </head>
  <body><a href={target}>InnovaAI</a></body>
</html>
