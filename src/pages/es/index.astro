---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Example from '../../components/Example.astro';
import UseCases from '../../components/UseCases.astro';
import Products from '../../components/Products.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import Principles from '../../components/Principles.astro';
import Tagline from '../../components/Tagline.astro';
import Audience from '../../components/Audience.astro';
import FAQ from '../../components/FAQ.astro';
import Closing from '../../components/Closing.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/es/site';
import { navigation } from '../../data/es/navigation';
import { footer } from '../../data/es/footer';
import { seo } from '../../data/es/seo';
import { hero } from '../../data/es/hero';
import { example } from '../../data/es/example';
import { useCases } from '../../data/es/use-cases';
import { products } from '../../data/es/products';
import { howWeWork } from '../../data/es/how-we-work';
import { principles } from '../../data/es/principles';
import { tagline } from '../../data/es/tagline';
import { audience } from '../../data/es/audience';
import { faq } from '../../data/es/faq';
import { closing } from '../../data/es/closing';
import { DENTIMED_URL, DICTA_URL } from '../../data/links';

const siteURL = new URL('/', Astro.site ?? 'https://innovai.click');
const pageURL = new URL('/es/', siteURL);
const orgId = `${siteURL.href}#organization`;
const serviceId = `${pageURL.href}#applied-ai-consulting`;
const structuredData = [
  {
    '@type': 'Service',
    '@id': serviceId,
    name: seo.home.serviceName,
    serviceType: seo.home.serviceType,
    description: seo.home.serviceDescription,
    url: pageURL.href,
    provider: { '@id': orgId },
    areaServed: ['Bolivia', 'Latin America'],
    audience: { '@type': 'BusinessAudience', audienceType: seo.home.audience },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: seo.home.serviceName,
      itemListElement: howWeWork.steps.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.offerName, description: s.body },
      })),
    },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteURL.href}#dentimed`,
    name: 'DentiMed',
    url: DENTIMED_URL,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    inLanguage: 'es',
    description: products.dentimed.tagline,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteURL.href}#dicta`,
    name: 'Dicta',
    url: DICTA_URL,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows, Linux',
    description: products.dicta.tagline,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'FAQPage',
    '@id': `${pageURL.href}#faq`,
    mainEntity: faq.items.map((i) => ({
      '@type': 'Question',
      name: i.question,
      acceptedAnswer: { '@type': 'Answer', text: i.answer },
    })),
  },
] satisfies Record<string, unknown>[];
---

<Layout
  title={seo.home.title}
  description={seo.home.description}
  lang="es"
  skipLink={site.skipLink}
  organizationDescription={seo.organizationDescription}
  ogImage={seo.ogImage}
  ogImageAlt={seo.ogImageAlt}
  structuredData={structuredData}
  mainEntityId={serviceId}
>
  <Header nav={navigation} site={site} />
  <main id="contenido">
    <Hero data={hero} site={site} />
    <Example data={example} />
    <UseCases data={useCases} />
    <Products data={products} site={site} />
    <HowWeWork data={howWeWork} />
    <Principles data={principles} />
    <Tagline data={tagline} />
    <Audience data={audience} />
    <FAQ data={faq} site={site} />
    <Closing data={closing} site={site} />
  </main>
  <Footer data={footer} site={site} />
</Layout>
