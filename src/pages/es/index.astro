---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Ribbon from '../../components/Ribbon.astro';
import DentimedHero from '../../components/dentimed/DentimedHero.astro';
import DentimedFeatures from '../../components/dentimed/DentimedFeatures.astro';
import Dicta from '../../components/Dicta.astro';
import CinematicStory from '../../components/CinematicStory.astro';
import EverydayWork from '../../components/EverydayWork.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import FAQ from '../../components/FAQ.astro';
import Closing from '../../components/Closing.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/es/site';
import { navigation } from '../../data/es/navigation';
import { footer } from '../../data/es/footer';
import { seo } from '../../data/es/seo';
import { dentimed } from '../../data/es/dentimed';
import { dicta } from '../../data/es/dicta';
import { cinema } from '../../data/es/cinema';
import { everydayWork } from '../../data/es/everyday-work';
import { howWeWork } from '../../data/es/how-we-work';
import { faq } from '../../data/es/faq';
import { closing } from '../../data/es/closing';
import { DENTIMED_URL, DICTA_URL } from '../../data/links';

const siteURL = new URL('/', Astro.site ?? 'https://innovai.click');
const pageURL = new URL('/es/', siteURL);
const orgId = `${siteURL.href}#organization`;
const structuredData = [
  {
    '@type': 'Service',
    '@id': `${pageURL.href}#service`,
    name: seo.home.serviceName,
    serviceType: seo.home.serviceType,
    description: seo.home.serviceDescription,
    url: pageURL.href,
    provider: { '@id': orgId },
    areaServed: 'Worldwide',
    audience: { '@type': 'BusinessAudience', audienceType: seo.home.audience },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: seo.home.serviceName,
      itemListElement: howWeWork.steps.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.offerName, description: s.body },
      })),
    },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteURL.href}#dentimed`,
    name: 'DentiMed',
    url: DENTIMED_URL,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    inLanguage: 'es',
    // the lockup subhead plus the review card's body: what DentiMed drafts and that you approve it
    description: `${dentimed.lockup.subhead} ${dentimed.features.items[1].body}`,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteURL.href}#dicta`,
    name: 'Dicta',
    url: DICTA_URL,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows, Linux',
    description: dicta.lockup.subhead,
    publisher: { '@id': orgId },
  },
  {
    '@type': 'FAQPage',
    '@id': `${pageURL.href}#faq`,
    mainEntity: faq.items.map((i) => ({
      '@type': 'Question',
      name: i.question,
      acceptedAnswer: { '@type': 'Answer', text: i.answer },
    })),
  },
] satisfies Record<string, unknown>[];
---

<Layout
  title={seo.home.title}
  description={seo.home.description}
  lang="es"
  skipLink={site.skipLink}
  organizationDescription={seo.organizationDescription}
  ogImage={seo.ogImage}
  ogImageAlt={seo.ogImageAlt}
  structuredData={structuredData}
>
  <Header nav={navigation} site={site} />
  <main id="contenido">
    <h1 class="sr-only">{site.h1}</h1>
    <Ribbon site={site} />
    <DentimedHero data={dentimed} />
    <DentimedFeatures data={dentimed} />
    <Dicta data={dicta} />
    <CinematicStory data={cinema} />
    <EverydayWork data={everydayWork} site={site} />
    <HowWeWork data={howWeWork} />
    <FAQ data={faq} site={site} />
    <Closing data={closing} site={site} />
  </main>
  <Footer data={footer} site={site} />
</Layout>
