---
/** InnovaAI lockup for dark surfaces only (header, menu, closing, footer): mark tile + "Innova" + gradient "AI". */
import { Image } from 'astro:assets';
import mark from '../../assets/brand/innovaai-mark.png';
interface Props { size?: 'sm' | 'md' | 'lg'; class?: string; /** above the fold (header pill) */ eager?: boolean }
const { size = 'sm', class: className = '', eager = false } = Astro.props;
const px = { sm: 32, md: 40, lg: 64 }[size];
const text = { sm: 'text-lg', md: 'text-2xl', lg: 'text-4xl' }[size];
const gap = { sm: 'gap-2', md: 'gap-2.5', lg: 'gap-3' }[size];
---
<span class:list={['inline-flex items-center', gap, className]}>
  <span class="shrink-0 overflow-hidden rounded-[28%] bg-logo-bg ring-1 ring-white/10" style={`width:${px}px;height:${px}px`}>
    <Image src={mark} alt="" width={px} height={px} densities={[1, 2]} loading={eager ? 'eager' : 'lazy'} class="size-full" />
  </span>
  <span class:list={['logo-word', text, 'font-display font-semibold leading-none tracking-tight text-white']}>Innova<span class="wm-ai">AI</span></span>
</span>
