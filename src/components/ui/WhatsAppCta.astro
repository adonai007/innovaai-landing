---
/** The one primary button on the page: blue, WhatsApp icon, opens wa.me in a new tab. */
import Icon from './Icon.astro';
interface Props {
  href: string;
  label: string;
  hint: string;
  size?: 'sm' | 'md' | 'lg';
  /** marks the hero and closing CTAs; the header CTA hides while one of them is in view */
  primary?: boolean;
  /** the header pill CTA (shown by scripts/header.ts) */
  headerCta?: boolean;
  class?: string;
}
const { href, label, hint, size = 'md', primary = false, headerCta = false, class: className = '' } = Astro.props;
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['btn btn-primary', { 'btn-sm': size === 'sm', 'btn-lg': size === 'lg' }, className]}
  data-primary-cta={primary ? '' : undefined}
  data-header-cta={headerCta ? '' : undefined}
>
  <Icon name="whatsapp-logo" class={size === 'sm' ? 'size-4 shrink-0' : 'size-5 shrink-0'} />
  {label}<span class="sr-only"> {hint}</span>
</a>
