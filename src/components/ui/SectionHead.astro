---
/** Eyebrow + h2 + optional intro. On dark sections the parent <section> carries .on-dark. */
import type { SectionHead as SectionHeadData } from '../../data/types';
interface Props { head: SectionHeadData; titleId: string; class?: string }
const { head, titleId, class: className = '' } = Astro.props;
---
<div data-reveal class:list={['max-w-[680px]', className]}>
  <p class="eyebrow">{head.eyebrow}</p>
  <h2 id={titleId} class="mt-3 text-h2 font-semibold">{head.title}</h2>
  {head.intro && <p class="section-intro mt-4 max-w-[36rem] text-lead">{head.intro}</p>}
  <slot />
</div>
