---
/** Floating dark translucent pill + full-screen <dialog> menu (below lg). Behaviour lives in scripts/header.ts. */
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import WhatsAppCta from './ui/WhatsAppCta.astro';
import LinkArrow from './ui/LinkArrow.astro';
import type { NavigationData, SiteData } from '../data/types';

interface Props {
  nav: NavigationData;
  site: SiteData;
}
const { nav, site } = Astro.props;
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-[max(12px,env(safe-area-inset-top))]">
  <div class="header-pill on-dark pointer-events-auto relative flex h-14 w-full max-w-5xl items-center justify-between gap-2 rounded-full bg-night/75 py-2 pr-2 pl-3 shadow-pill backdrop-blur-lg backdrop-saturate-150">
    <a href="#inicio" aria-label={nav.homeLabel} class="shrink-0 rounded-full"><Logo size="sm" eager /></a>

    <nav aria-label={nav.navLabel} class="hidden lg:absolute lg:top-1/2 lg:left-1/2 lg:block lg:-translate-x-1/2 lg:-translate-y-1/2">
      <ul class="flex gap-1">
        {
          nav.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-full px-3 py-2.5 font-display text-sm font-medium text-white/80 transition-[color,background-color] duration-300 ease-brand hover:bg-white/8 hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* The CTA slot sits left of the language link: when it collapses, the language link stays put at the pill's end. */}
    <div class="flex items-center gap-1">
      <span class="header-cta-slot" data-header-cta-slot>
        <span class="header-cta-clip">
          <WhatsAppCta size="sm" headerCta href={site.whatsappHref} label={site.ctaShort} hint={site.externalHint} class="header-cta" />
        </span>
      </span>
      <a
        href={nav.lang.href}
        hreflang={nav.lang.hreflang}
        lang={nav.lang.hreflang}
        aria-label={nav.lang.ariaLabel}
        class="hidden size-10 place-items-center rounded-full font-display text-sm font-semibold text-white/80 ring-1 ring-white/15 transition-[color,background-color] duration-300 ease-brand ring-inset hover:bg-white/8 hover:text-white sm:grid"
      >
        {nav.lang.short}
      </a>
      <button
        type="button"
        data-menu-open
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label={nav.menuOpen}
        class="grid size-10 shrink-0 place-items-center rounded-full text-white transition-[color,background-color] duration-300 ease-brand hover:bg-white/8 lg:hidden"
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <dialog id="site-menu" class="menu-dialog on-dark" aria-label={nav.menuTitle} data-lenis-prevent>
    <div class="mx-auto flex h-full max-w-5xl flex-col px-4">
      <div class="mt-[max(12px,env(safe-area-inset-top))] flex h-14 shrink-0 items-center justify-between pr-2 pl-3">
        <Logo size="sm" />
        <button
          type="button"
          data-menu-close
          aria-label={nav.menuClose}
          class="grid size-10 place-items-center rounded-full text-white transition-[color,background-color] duration-300 ease-brand hover:bg-white/8"
        >
          <Icon name="x" class="size-5" />
        </button>
      </div>

      <nav aria-label={nav.navLabel} class="mt-8 px-3">
        <ul class="border-t border-white/10">
          {
            nav.links.map((link) => (
              <li>
                <a
                  data-menu-link
                  href={link.href}
                  class="group flex items-center justify-between border-b border-white/10 py-4 font-display text-2xl font-medium tracking-tight text-white"
                >
                  {link.label}
                  <Icon
                    name="arrow-right"
                    class="size-5 text-white/50 transition-transform duration-300 ease-brand group-hover:translate-x-0.5 group-hover:text-white"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-8 flex flex-col items-start gap-1 px-3">
        <a
          href={nav.lang.href}
          hreflang={nav.lang.hreflang}
          lang={nav.lang.hreflang}
          class="py-2 text-lg text-white/80 transition-[color,background-color] duration-300 ease-brand hover:text-white"
        >
          {nav.lang.long}
        </a>
        <LinkArrow href={nav.linkedin.href} label={nav.linkedin.label} external icon="arrow-up-right" hint={site.externalHint} />
      </div>

      <div class="mt-auto px-3 pt-8 pb-[max(24px,env(safe-area-inset-bottom))]">
        <WhatsAppCta size="lg" href={site.whatsappHref} label={site.cta} hint={site.externalHint} class="w-full" />
      </div>
    </div>
  </dialog>
</header>

<style is:global>
  .menu-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 400ms var(--ease-brand),
      top 400ms var(--ease-brand);
  }
  .menu-icon span:first-child {
    top: 2px;
  }
  .menu-icon span:last-child {
    top: 8px;
  }
  [aria-expanded='true'] > .menu-icon span:first-child {
    top: 5px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] > .menu-icon span:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  /* Header CTA: hidden while a primary CTA is in view (scripts/header.ts). Its slot collapses to zero
     width (grid 0fr to 1fr) so the pill never shows an empty gap. The nav is centered on its own and the
     language link sits after the slot, so nothing else moves. The clip's padding and negative margin keep
     the focus ring visible. */
  html.js .header-cta-slot {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 400ms var(--ease-brand);
  }
  html.js .header-cta-slot.is-shown {
    grid-template-columns: 1fr;
  }
  html.js .header-cta-clip {
    min-width: 0;
    overflow: hidden;
    padding: 6px;
    margin: -6px;
  }
  html.js .header-cta:not(.is-shown) {
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
  }

  /* Narrow phones (small Androids, large display size): the ES label needs the room. Drop the glyph and
     tighten the padding below 375px, and keep only the mark tile below 340px, so the CTA never runs
     under the burger. */
  @media (max-width: 374px) {
    .header-cta {
      padding-inline: 0.75rem;
    }
    .header-cta svg {
      display: none;
    }
  }
  @media (max-width: 339px) {
    .header-pill .logo-word {
      display: none;
    }
  }

  /* Windows high contrast: the bars are drawn with a system colour and the pill gets an opaque surface */
  @media (forced-colors: active) {
    .menu-icon span {
      background: ButtonText;
    }
    .header-pill {
      background: Canvas;
      border: 1px solid CanvasText;
    }
  }

  .menu-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-night);
    color: #fff;
    pointer-events: auto;
  }
  .menu-dialog::backdrop {
    background: transparent;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  html.motion .menu-dialog[open] {
    animation: menu-in 400ms var(--ease-brand);
  }
  html.no-js [data-menu-open] {
    display: none;
  }
</style>
