---
/**
 * Global nav (Apple style): a 44px frosted bar (48px below 834px), sticky at the top. Logo left, five links
 * centred from 834px, language link and a small blue pill on the right, plus the menu button below 834px.
 * data-theme switches to "dark" while a [data-nav-theme="dark"] section sits under the bar (scripts/header.ts).
 * The menu is a native <dialog> (showModal: focus trap, Escape, inert page), solid white so the page behind
 * never shows through, with its links in the page's 87.5% column. Without JS the menu button is
 * hidden and the links show as a second, horizontally scrollable row below 834px.
 */
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import ChevronLink from './ui/ChevronLink.astro';
import type { NavigationData, SiteData } from '../data/types';

interface Props {
  nav: NavigationData;
  site: SiteData;
}
const { nav, site } = Astro.props;
---

<header
  data-nav
  data-theme="light"
  class="nav-bar sticky top-0 z-50 h-[var(--nav-h)] bg-white/80 text-ink backdrop-blur-[20px] backdrop-saturate-[1.8] transition-[background-color,color] duration-[320ms] ease-standard data-[theme=dark]:bg-night-3/80 data-[theme=dark]:text-on-night"
>
  <div
    class="mx-auto flex h-[var(--nav-h)] max-w-[64rem] items-center justify-between gap-4 px-4 nav:grid nav:grid-cols-[1fr_auto_1fr] nav:px-[1.375rem]"
  >
    <a href="#top" aria-label={nav.homeLabel} class="nav-home flex h-full items-center justify-self-start">
      <Logo size="nav" eager />
    </a>

    <nav aria-label={nav.navLabel} class="hidden h-full nav:block">
      <ul class="flex h-full">
        {
          nav.links.map((link) => (
            <li class="h-full">
              <a href={link.href} class="nav-link flex h-full items-center px-2 text-legal whitespace-nowrap">
                <span class="nav-label">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5 justify-self-end nav:gap-2">
      <a
        href={nav.lang.href}
        hreflang={nav.lang.hreflang}
        lang={nav.lang.hreflang}
        aria-label={nav.lang.ariaLabel}
        class="nav-link hidden h-[var(--nav-h)] items-center px-2 text-legal nav:flex"
      >
        <span class="nav-label">{nav.lang.short}</span>
      </a>
      <Button size="nav" href={site.whatsappHref} label={site.ctaShort} external hint={site.whatsappHint} />
      <button
        type="button"
        data-menu-open
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label={nav.menuOpen}
        class="nav-burger -mr-3.5 grid size-11 shrink-0 place-items-center nav:hidden"
      >
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav aria-label={nav.navLabel} class="nav-nojs">
    <ul class="flex h-10 items-center gap-1 overflow-x-auto px-2.5">
      {
        nav.links.map((link) => (
          <li class="shrink-0">
            <a href={link.href} class="nav-link flex h-10 items-center px-1.5 text-legal whitespace-nowrap">
              <span class="nav-label">{link.label}</span>
            </a>
          </li>
        ))
      }
      <li class="shrink-0">
        <a
          href={nav.lang.href}
          hreflang={nav.lang.hreflang}
          lang={nav.lang.hreflang}
          aria-label={nav.lang.ariaLabel}
          class="nav-link flex h-10 items-center px-1.5 text-legal"
        >
          <span class="nav-label">{nav.lang.short}</span>
        </a>
      </li>
    </ul>
  </nav>

  <dialog
    id="site-menu"
    class="menu bg-white text-ink"
    aria-label={nav.menuTitle}
  >
    <div class="flex min-h-full flex-col">
      <div class="mx-auto flex h-[var(--nav-h)] w-full max-w-[64rem] shrink-0 items-center justify-between px-4">
        <Logo size="nav" />
        <button type="button" data-menu-close aria-label={nav.menuClose} class="-mr-3.5 grid size-11 place-items-center">
          <span class="burger is-x" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>

      <div class="menu-body mx-auto flex w-[87.5%] max-w-[61.25rem] grow flex-col pt-5">
        <nav aria-label={nav.navLabel}>
          <ul>
            {
              nav.links.map((link, i) => (
                <li class="menu-item" style={`--i:${i}`}>
                  <a data-menu-link href={link.href} class="menu-link block py-2 text-[1.75rem] leading-[1.14] font-semibold tracking-[var(--tr-card)]">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="menu-item mt-8 flex flex-col items-start gap-3" style={`--i:${nav.links.length}`}>
          <a
            href={nav.lang.href}
            hreflang={nav.lang.hreflang}
            lang={nav.lang.hreflang}
            class="menu-lang text-body text-ink-2"
          >
            {nav.lang.long}
          </a>
          <ChevronLink href={nav.linkedin.href} label={nav.linkedin.label} external hint={site.externalHint} />
        </div>

        <div class="menu-item mt-auto pt-10 pb-[max(1.5rem,env(safe-area-inset-bottom))] md:max-w-[22rem]" style={`--i:${nav.links.length + 1}`}>
          <Button size="l" class="w-full" label={site.cta} href={site.whatsappHref} external hint={site.whatsappHint} />
        </div>
      </div>
    </div>
  </dialog>
</header>

<style is:global>
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav-bar { background-color: #fbfbfd; }
    .nav-bar[data-theme='dark'] { background-color: #161617; }
  }

  .nav-link {
    color: rgb(0 0 0 / 0.8);
    transition: color 320ms var(--ease-standard);
  }
  .nav-link:hover { color: var(--color-ink); }
  [data-theme='dark'] .nav-link { color: rgb(255 255 255 / 0.8); }
  [data-theme='dark'] .nav-link:hover { color: #fff; }
  /* full-height links: the focus ring hugs the label, not the 44px hit area */
  .nav-link:focus-visible, .nav-home:focus-visible { outline: none; }
  .nav-link:focus-visible .nav-label, .nav-home:focus-visible .logo {
    outline: 2px solid var(--color-action); outline-offset: 0.25rem; border-radius: 4px;
  }
  [data-theme='dark'] .nav-link:focus-visible .nav-label,
  [data-theme='dark'] .nav-home:focus-visible .logo { outline-color: var(--color-link-on-night); }

  /* menu open and close buttons: the ring hugs the 16px glyph inside the 44px hit area, so the viewport edge
     never clips it */
  [data-menu-open]:focus-visible, [data-menu-close]:focus-visible { outline: none; }
  [data-menu-open]:focus-visible > .burger, [data-menu-close]:focus-visible > .burger {
    outline: 2px solid var(--color-action); outline-offset: 0.5rem; border-radius: 6px;
  }
  [data-theme='dark'] [data-menu-open]:focus-visible > .burger { outline-color: var(--color-link-on-night); }

  /* menu button: two 16px lines that turn into an X */
  .burger {
    position: relative;
    display: block;
    width: 1rem;
    height: 1rem;
  }
  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 0.09375rem;
    border-radius: 1px;
    background: currentColor;
    transition: transform 320ms var(--ease-standard), top 320ms var(--ease-standard);
  }
  .burger span:first-child { top: 0.25rem; }
  .burger span:last-child { top: 0.65625rem; }
  [aria-expanded='true'] > .burger span,
  .burger.is-x span { top: 0.453125rem; }
  [aria-expanded='true'] > .burger span:first-child,
  .burger.is-x span:first-child { transform: rotate(45deg); }
  [aria-expanded='true'] > .burger span:last-child,
  .burger.is-x span:last-child { transform: rotate(-45deg); }
  @media (forced-colors: active) {
    .burger span { background: ButtonText; }
  }

  /* no-JS: the menu button is useless, so the links become a scrollable second row below 834px */
  .nav-nojs { display: none; }
  html.no-js [data-menu-open] { display: none; }
  @media (max-width: 52.0625em) {
    html.no-js { scroll-padding-top: calc(var(--nav-h) + 2.5rem); }
    html.no-js [data-nav] :is(a, button) { scroll-margin-top: calc(-1 * (var(--nav-h) + 2.5rem)); }
    html.no-js [data-nav] { height: auto; }
    html.no-js .nav-nojs { display: block; }
  }
  .nav-nojs ul { scrollbar-width: none; }
  .nav-nojs ul::-webkit-scrollbar { display: none; }

  /* full-screen light menu */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu::backdrop { background: transparent; }
  .menu-link { transition: color 320ms var(--ease-standard); }
  .menu-link:hover { color: var(--color-ink-2); }
  .menu-lang:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 0.18em; }
  @keyframes menu-fade { from { opacity: 0; } }
  @keyframes menu-rise { from { opacity: 0; transform: translateY(0.5rem); } }
  html.motion .menu[open] { animation: menu-fade 240ms var(--ease-out); }
  html.motion .menu[open] .menu-item {
    animation: menu-rise 400ms var(--ease-out) both;
    animation-delay: calc(60ms + var(--i, 0) * 30ms);
  }
</style>
