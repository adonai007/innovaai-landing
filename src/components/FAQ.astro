---
/** 4.9 FAQ: sticky heading on the left, native details/summary accordion on the right. No JS. */
import Icon from './ui/Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import type { FaqData, SiteData } from '../data/types';
interface Props { data: FaqData; site: SiteData }
const { data, site } = Astro.props;
// head.intro holds the text before the WhatsApp link, so it is rendered in the slot instead.
const head = { ...data.head, intro: undefined };
---

<section id="preguntas" class="section bg-white" aria-labelledby="preguntas-title">
  <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-24">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHead head={head} titleId="preguntas-title">
        <p class="section-intro mt-4 max-w-[36rem] text-lead">
          {data.head.intro}<a class="text-link" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">{data.introLink}<span class="sr-only"> {site.externalHint}</span></a>{data.introEnd}
        </p>
      </SectionHead>
    </div>
    <div class="divide-y divide-line border-y border-line" data-reveal style="--reveal-delay:120ms">
      {
        data.items.map((item) => (
          <details class="group">
            <summary class="flex cursor-pointer items-start justify-between gap-6 py-6">
              <h3 class="font-display text-lg font-medium">{item.question}</h3>
              <Icon
                name="plus"
                class="mt-1 size-5 shrink-0 text-action transition-transform duration-500 ease-brand group-open:rotate-45"
              />
            </summary>
            <p class="max-w-[60ch] pb-6 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
