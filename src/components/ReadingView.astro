---
import FAQ from './FAQ.astro';
import Closing from './Closing.astro';
import type { ReadingData, FaqData, SiteData, ClosingData } from '../data/types';
interface Props { data: ReadingData; faq: FaqData; site: SiteData; closing: ClosingData; }
const { data, faq, site, closing } = Astro.props;
---

<main id="contenido" tabindex="-1" class="reading-view bg-canvas">
  <div class="wrap-text py-16 md:py-24">
    <section id="inicio" aria-labelledby="resumen-title">
      <h1 id="resumen-title" class="text-hero">{data.title}</h1>
      <p class="mt-6 max-w-[45rem] text-intro text-ink-2">{data.description}</p>
      <a class="text-link mt-6 inline-flex min-h-11 items-center" href={data.presentation.href}>{data.presentation.label}</a>
    </section>
    <nav aria-label={data.navLabel} class="mt-10 rounded-2xl bg-canvas-alt p-6 md:p-8">
      <h2 class="text-label">{data.indexTitle}</h2>
      <ul class="mt-4 grid gap-x-8 md:grid-cols-2">
        {data.index.map((link) => <li><a href={link.href} class="text-link inline-flex min-h-11 items-center">{link.label}</a></li>)}
      </ul>
    </nav>
    {data.sections.map((section) => (
      <section id={section.id} aria-labelledby={`${section.id}-title`} class="mt-16 border-t border-hairline pt-12">
        <p class="text-caption text-ink-2">{section.label}</p>
        <h2 id={`${section.id}-title`} class="mt-3 text-section whitespace-pre-line">{section.title}</h2>
        <p class="mt-5 max-w-[45rem] text-intro text-ink-2">{section.body}</p>
        <ul class="mt-8 grid gap-8">
          {section.items.map((item) => <li><h3 class="text-label whitespace-pre-line">{item.title}</h3><p class="mt-2 max-w-[45rem] text-ink-2">{item.body}</p></li>)}
        </ul>
        {section.links && <ul class="mt-6 flex flex-wrap gap-x-8">{section.links.map((link) => (
          <li><a class="text-link inline-flex min-h-11 items-center" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
            {link.label}{link.external && <span class="sr-only"> {link.srHint ?? site.externalHint}</span>}
          </a></li>
        ))}</ul>}
      </section>
    ))}
  </div>
  <FAQ data={faq} site={site} expanded />
  <Closing data={closing} site={site} />
</main>
