---
/** 4.8 Audience "Para quién es": self-qualification list. No CTA here, so it never repeats the closing. */
import Icon from './ui/Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import type { AudienceData } from '../data/types';
interface Props { data: AudienceData }
const { data } = Astro.props;
---

<section id="para-quien" class="section bg-sky" aria-labelledby="para-quien-title">
  <div class="wrap grid gap-12 lg:grid-cols-2 lg:gap-24">
    <SectionHead head={data.head} titleId="para-quien-title" />
    <div data-reveal style="--reveal-delay:120ms">
      <ul class="grid gap-3">
        {
          data.items.map((item) => (
            <li class="flex gap-4 rounded-2xl bg-white p-5">
              <Icon name="check-circle" weight="fill" class="mt-0.5 size-6 shrink-0 text-action" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-muted">{data.note}</p>
    </div>
  </div>
</section>
