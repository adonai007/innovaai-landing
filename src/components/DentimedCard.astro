---
/**
 * DentiMed product card, dressed in DentiMed's own brand (mint, ink, teal) inside the InnovaAI page.
 * Default markup is the final state: chip "Aprobado". scripts/product-demos.ts flips it to "Borrador" and back
 * once, in motion mode only. Copy follows DentiMed's hard rules (SPEC 8.8).
 */
import { Picture } from 'astro:assets';
import Icon from './ui/Icon.astro';
import LinkArrow from './ui/LinkArrow.astro';
import dentimedPhoto from '../assets/photos/dentimed-recepcion.webp';
import dentimedIcon from '../assets/brand/dentimed-icon.svg';
import type { DentimedProduct } from '../data/types';

interface Props {
  data: DentimedProduct;
}
const { data } = Astro.props;
// Microcopy wraps only at its "·" separators, never inside a segment.
const metaParts = data.meta.split(' · ');
---

<article data-reveal data-dm-card class="product-card flex flex-col overflow-hidden rounded-[2rem] bg-dm-mint text-dm-ink">
  <div class="relative aspect-[4/3] overflow-hidden bg-[#dfeeea] sm:aspect-[16/10]">
    {/*
      sizes = the width the 16:9 photo is drawn at under object-cover, not the frame width:
      lg column (max 544px) x 1.11 at 16:10; sm full width x 1.11 at 16:10; base full width x 1.33 at 4:3.
    */}
    <Picture
      src={dentimedPhoto}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 1024px) 605px, (min-width: 640px) calc(111vw - 54px), calc(133vw - 43px)"
      loading="lazy"
      decoding="async"
      alt={data.imageAlt}
      class="size-full object-cover"
      style="object-position: 58% 30%"
      pictureAttributes={{ class: 'block size-full' }}
    />
    <div
      aria-hidden="true"
      class="absolute right-4 bottom-4 left-4 flex items-center gap-2.5 rounded-2xl bg-white p-3 text-ui text-dm-ink shadow-float sm:right-auto sm:bottom-5 sm:left-5 sm:max-w-[calc(100%-2.5rem)] sm:gap-3 sm:pr-4"
      data-dm-chip-card
    >
      <img src={dentimedIcon.src} alt="" width="32" height="32" class="size-8 shrink-0" loading="lazy" decoding="async" />
      <div class="min-w-0">
        <p class="font-semibold">{data.chip.title}</p>
        <p class="text-xs text-dm-muted">{data.chip.detail}</p>
      </div>
      <span data-dm-chip data-state="approved" class="dm-chip ml-auto shrink-0 sm:pl-1">
        <span class="chip chip-draft dm-chip-draft">{data.chip.draft}</span>
        <span class="chip dm-chip-ok bg-dm-mint text-dm-action"><Icon name="check" class="size-3 max-[389px]:hidden" />{data.chip.approved}</span>
      </span>
    </div>
  </div>

  <div class="product-body flex flex-1 flex-col p-6 sm:p-8 lg:p-10">
    <p class="flex items-center gap-3" aria-hidden="true">
      <img src={dentimedIcon.src} alt="" width="40" height="40" class="size-10 shrink-0" loading="lazy" decoding="async" />
      <span class="font-display text-2xl leading-none font-semibold tracking-tight">Denti<span class="text-dm-med">Med</span></span>
    </p>
    <p class="mt-6 font-display text-sm font-medium text-dm-action">{data.eyebrow}</p>
    <h3 class="mt-2 text-h3-lg font-semibold"><span class="sr-only">{data.name}. </span>{data.tagline}</h3>
    <p class="mt-4 max-w-[34rem] text-dm-muted">{data.body}</p>
    <div>
      <ul class="mt-6 grid gap-3">
        {
          data.bullets.map((b) => (
            <li class="flex gap-3">
              <Icon name="check-circle" weight="fill" class="mt-0.5 size-5 shrink-0 text-dm-action" />
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-dm-muted">{metaParts.map((part, i) => <Fragment>{i > 0 && '\u00a0· '}<span class="whitespace-nowrap">{part}</span></Fragment>)}</p>
    </div>
    <div class="mt-auto pt-8">
      <LinkArrow
        href={data.cta.href}
        label={data.cta.label}
        icon="arrow-up-right"
        external
        hint={data.cta.srHint}
        class="text-dm-action decoration-dm-action/30 hover:decoration-dm-action"
      />
    </div>
  </div>
</article>

<style>
  /* Two chip states stacked in one cell, so the overlay never changes width when they swap. */
  .dm-chip {
    display: inline-grid;
  }
  .dm-chip > .chip {
    grid-area: 1 / 1;
    justify-self: end;
    transition: opacity 300ms var(--ease-brand);
  }
  .dm-chip-draft {
    opacity: 0;
  }
  .dm-chip[data-state='draft'] .dm-chip-draft {
    opacity: 1;
  }
  .dm-chip[data-state='draft'] .dm-chip-ok {
    opacity: 0;
  }
</style>
