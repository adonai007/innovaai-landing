---
/**
 * Everyday work (#que-construimos): examples of tools the studio builds with a team, as a bento of white cards on
 * #f5f5f7. The first item (from a voice note to a record, the bridge from DentiMed and Dicta) is the lead card:
 * two columns wide (and two rows tall from 1069px), a larger title and an abstract picture of the idea, a voice
 * waveform turning into filled, checked fields (shapes only: no words, no names, no data). The other five are
 * compact cards: a blue Phosphor icon, the title and the body (aligned across a row through subgrid). One chevron
 * link to WhatsApp below the grid.
 */
import Icon from './ui/Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import ChevronLink from './ui/ChevronLink.astro';
import type { EverydayWorkData, SiteData } from '../data/types';

interface Props {
  data: EverydayWorkData;
  site: SiteData;
}
const { data, site } = Astro.props;
const [lead, ...rest] = data.items;
/** waveform bar heights in % (decorative) */
const WAVE = [22, 38, 56, 34, 70, 88, 62, 44, 76, 100, 82, 52, 36, 64, 90, 72, 48, 30, 54, 40, 26, 18];
/** filled-field rows: label and value widths in % (decorative) */
const ROWS = [
  [34, 78],
  [26, 62],
  [40, 70],
  [30, 50],
];
---

<section id="que-construimos" aria-labelledby="que-construimos-title" class="section bg-canvas-alt">
  <div class="wrap">
    <SectionHead title={data.title} titleId="que-construimos-title" intro={data.intro} />

    <ul class="mt-[var(--head-gap)] grid gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
      <li data-reveal class="ew-lead flex flex-col overflow-hidden rounded-card bg-canvas md:col-span-2">
        <div class="p-7 md:p-8 lg:p-10">
          <h3 class="text-section">{lead.title}</h3>
          <p class="mt-4 max-w-[34rem] text-intro text-ink-2">{lead.body}</p>
        </div>
        <div class="ew-visual" aria-hidden="true">
          <div class="ew-wave">
            {WAVE.map((h) => <span style={`height:${h}%`} />)}
          </div>
          <svg class="ew-arrow" viewBox="0 0 7 12" focusable="false">
            <path d="M1 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div class="ew-record">
            {
              ROWS.map(([label, value]) => (
                <div class="ew-row">
                  <span class="ew-check">
                    <Icon name="check" class="size-3" />
                  </span>
                  <i class="ew-label" style={`width:${label}%`} />
                  <i class="ew-value" style={`width:${value}%`} />
                </div>
              ))
            }
          </div>
        </div>
      </li>
      {
        rest.map((item, i) => (
          <li
            data-reveal
            style={`--reveal-delay: ${(i + 1) * 60}ms`}
            class:list={[
              'ew-card flex flex-col rounded-card bg-canvas p-7 md:p-8 lg:p-10',
              { 'md:col-span-2 lg:col-span-1': i === rest.length - 1 },
            ]}
          >
            <Icon name={item.icon} class="size-9 shrink-0 text-action" />
            <h3 class="mt-auto pt-8 text-card">{item.title}</h3>
            <p class="mt-3 text-ink-2">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 text-center">
      <ChevronLink size="intro" href={site.whatsappHref} label={data.cta} external hint={site.whatsappHint} />
    </p>
  </div>
</section>

<style>
  /* The lead card is two columns wide, and from 1069px two cards tall. Where subgrid is supported, every compact
     card spans three shared rows (icon, title, body), so titles and bodies line up across a row whatever their
     length, and the lead spans the same rows (three, six from 1069px). Otherwise each compact card is a flex
     column with the copy pushed to the bottom. */
  @media (min-width: 66.8125em) {
    .ew-lead {
      grid-row: span 2;
    }
  }
  @supports (grid-template-rows: subgrid) {
    .ew-card {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .ew-lead {
      grid-row: span 3;
    }
    @media (min-width: 66.8125em) {
      .ew-lead {
        grid-row: span 6;
      }
    }
  }

  /* the lead card's picture: a waveform, a chevron, then a panel of filled fields with blue checks */
  .ew-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding: 0.5rem 1.75rem 1.75rem;
  }
  .ew-wave {
    display: flex;
    align-items: center;
    gap: 0.1875rem;
    height: 4.5rem;
  }
  .ew-wave span {
    width: 0.1875rem;
    min-height: 0.1875rem;
    border-radius: 99px;
    background: var(--color-action);
  }
  .ew-arrow {
    width: 0.5rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: var(--color-ink-2);
    rotate: 90deg;
  }
  .ew-record {
    display: grid;
    gap: 0.875rem;
    width: 100%;
    max-width: 22rem;
    padding: 1.25rem;
    border-radius: var(--radius-tile);
    background: var(--color-canvas-alt);
  }
  .ew-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ew-check {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    border-radius: 99px;
    background: var(--color-action);
    color: #fff;
  }
  .ew-label,
  .ew-value {
    display: block;
    flex: 0 1 auto;
    height: 0.5rem;
    border-radius: 99px;
  }
  /* field name light, filled value darker */
  .ew-label {
    max-width: 30%;
    background: var(--color-fill);
  }
  .ew-value {
    background: rgb(0 0 0 / 0.3);
  }
  @media (min-width: 45.9375em) {
    .ew-visual {
      flex-direction: row;
      justify-content: center;
      gap: 2rem;
      padding: 1rem 2rem 2.5rem;
    }
    .ew-wave {
      gap: 0.25rem;
      height: 7rem;
    }
    .ew-wave span {
      width: 0.25rem;
    }
    .ew-arrow {
      rotate: none;
    }
    .ew-record {
      flex: 0 1 24rem;
      max-width: none;
      padding: 1.5rem;
      gap: 1.125rem;
    }
  }
  @media (min-width: 66.8125em) {
    .ew-visual {
      gap: 3rem;
      padding: 1.5rem 2.5rem 3.5rem;
    }
    .ew-wave {
      gap: 0.3125rem;
      height: 10rem;
    }
    .ew-wave span {
      width: 0.3125rem;
    }
    .ew-arrow {
      width: 0.625rem;
      height: 1.125rem;
    }
    .ew-record {
      flex-basis: 24rem;
      padding: 2rem;
      gap: 1.375rem;
    }
    .ew-row {
      gap: 0.875rem;
    }
    .ew-check {
      width: 1.5rem;
      height: 1.5rem;
    }
    .ew-label,
    .ew-value {
      height: 0.625rem;
    }
  }
</style>
