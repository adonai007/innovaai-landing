---
/**
 * Products: proof that InnovaAI builds what it recommends. Two cards, each in its own product brand,
 * equal height on lg (subgrid aligns every row across both cards), then the "next one is yours" row.
 */
import SectionHead from './ui/SectionHead.astro';
import LinkArrow from './ui/LinkArrow.astro';
import Icon from './ui/Icon.astro';
import DentimedCard from './DentimedCard.astro';
import DictaCard from './DictaCard.astro';
import type { ProductsData, SiteData } from '../data/types';

interface Props {
  data: ProductsData;
  site: SiteData;
}
const { data, site } = Astro.props;
---

<section id="productos" aria-labelledby="productos-title" class="section border-t border-line bg-white">
  <div class="wrap">
    {/* split head: the claim on the left, the "they are ours" intro on the right, sharing the h2's last line */}
    <div class="grid gap-4 lg:grid-cols-2 lg:items-end lg:gap-24">
      <SectionHead head={{ ...data.head, intro: undefined }} titleId="productos-title" />
      <p data-reveal style="--reveal-delay:120ms" class="section-intro max-w-[36rem] text-lead lg:pb-1">{data.head.intro}</p>
    </div>

    <div class="products-grid mt-12 grid gap-4 lg:mt-16 lg:grid-cols-2">
      <DentimedCard data={data.dentimed} />
      <DictaCard data={data.dicta} />
    </div>
    <p class="mt-4 text-xs text-muted">{data.caption}</p>

    <div
      data-reveal
      class="mt-8 flex flex-col gap-4 rounded-3xl border border-dashed border-line p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:p-8"
    >
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-sky text-action">
          <Icon name="plus" class="size-5" />
        </span>
        <div>
          <h3 class="text-xl font-semibold tracking-tight">{data.next.title}</h3>
          <p class="mt-1 text-muted">{data.next.body}</p>
        </div>
      </div>
      <LinkArrow
        href={site.whatsappHref}
        label={data.next.cta}
        external
        hint={site.externalHint}
        class="shrink-0 self-start sm:self-auto"
      />
    </div>
  </div>
</section>

<style>
  /*
   * lg: both cards share one 7-row track list (visual, lockup, eyebrow, title, body, bullets with meta, link),
   * so titles, lists and links line up across the two brands. Without subgrid they stay flex columns of equal height.
   */
  @media (min-width: 64rem) {
    @supports (grid-template-rows: subgrid) {
      .products-grid {
        grid-template-rows: repeat(7, auto);
        row-gap: 0;
      }
      .products-grid > :global(.product-card) {
        grid-row: span 7;
        display: grid;
        grid-template-rows: subgrid;
      }
      .products-grid > :global(.product-card) > :global(.product-body) {
        grid-row: span 6;
        display: grid;
        grid-template-rows: subgrid;
      }
      /* Shorter content sits at the top of its shared row instead of stretching (the link keeps mt-auto). */
      .products-grid > :global(.product-card) > :global(.product-body) > :global(*) {
        align-self: start;
      }
    }
  }
</style>
