---
/** 4.6 Principles: night section, 2x2 hairline grid of the four rules. */
import Icon from './ui/Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import type { PrinciplesData } from '../data/types';
interface Props { data: PrinciplesData }
const { data } = Astro.props;
---

<section id="principios" class="section on-dark bg-night" aria-labelledby="principios-title">
  <div class="wrap">
    {/* centered over the hairline grid (the only centered section head on the page) */}
    <SectionHead head={data.head} titleId="principios-title" class="mx-auto text-center [&_.section-intro]:mx-auto" />
    <ul class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:mt-16">
      {
        data.items.map((item, i) => (
          <li class="bg-night p-6 sm:p-8 lg:p-10">
            {/* reveal on the inner div so the white/10 grid never flashes through a hidden li */}
            <div data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <Icon name={item.icon} class="size-7 text-teal" />
              <h3 class="mt-6 text-xl font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-2 text-white/70">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
