---
/**
 * Hero: the idea, both CTAs above the fold, and a real team photo with an interactive draft card
 * hanging off its edge. The default markup is the final state; motion only exists under html.motion.
 * Never add data-reveal here (SPEC 6.3).
 */
import { Picture } from 'astro:assets';
import WhatsAppCta from './ui/WhatsAppCta.astro';
import LinkArrow from './ui/LinkArrow.astro';
import HeroDraftCard from './HeroDraftCard.astro';
import photo from '../assets/photos/equipo-proceso.webp';
import type { HeroData, SiteData } from '../data/types';

interface Props {
  data: HeroData;
  site: SiteData;
}
const { data, site } = Astro.props;
// One line per sentence ("La IA prepara el trabajo." / "Tu equipo decide."), so the h1 never breaks mid-thought.
const titleLines = data.title.split(/(?<=\.)\s+/);
---

<section id="inicio" aria-labelledby="inicio-title" class="relative bg-soft pt-24 pb-16 sm:pt-28 lg:pt-36 lg:pb-24">
  <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16">
    <div class="hero-copy max-w-[560px]">
      <p class="eyebrow" style="--i:0">{data.eyebrow}</p>
      <h1 id="inicio-title" class="mt-4 text-display font-semibold text-ink" style="--i:1">
        {titleLines.map((line, i) => <span class="block">{i > 0 ? ' ' : ''}{line}</span>)}
      </h1>
      <p class="mt-6 text-lead text-muted" style="--i:2">{data.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6" style="--i:3">
        <WhatsAppCta size="lg" primary href={site.whatsappHref} label={site.cta} hint={site.externalHint} class="w-full sm:w-auto" />
        <LinkArrow href={data.ctaSecondary.href} label={data.ctaSecondary.label} icon="arrow-down" class="self-start whitespace-nowrap sm:self-auto" />
      </div>
      <p class="mt-6 text-sm text-muted" style="--i:4">{data.reassurance}</p>
    </div>

    <figure class="relative">
      {/*
        sizes = the width the 3:2 photo is drawn at under object-cover, not the frame width:
        lg frame height (max 640) x 1.5 x 1.08 parallax scale; sm 5:4 frame; base 4:5 frame.
      */}
      <div
        class="hero-photo relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-night sm:aspect-[5/4] lg:aspect-auto lg:h-[min(72svh,640px)] lg:min-h-[480px] lg:rounded-island"
      >
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1200, 1536]}
          sizes="(min-width: 1024px) 1040px, (min-width: 640px) calc(120vw - 58px), calc(187.5vw - 60px)"
          loading="eager"
          fetchpriority="high"
          alt={data.photoAlt}
          class="size-full object-cover object-[40%_50%] lg:object-[20%_50%] xl:object-[28%_50%]"
          pictureAttributes={{ class: 'block size-full' }}
        />
      </div>
      <div class="hero-card absolute inset-x-3 bottom-12 sm:inset-x-auto sm:bottom-14 sm:left-6 sm:w-[320px] lg:bottom-16 lg:-left-10 lg:w-[340px]">
        <HeroDraftCard draft={data.draft} />
      </div>
      <figcaption class="mt-3 text-xs text-muted">{site.demoNote}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Load motion (html.motion only). Text moves by transform only, never opacity, so the LCP is not delayed. */
  @keyframes hero-rise {
    from {
      transform: translateY(1.5rem);
    }
  }
  @keyframes hero-unclip {
    from {
      clip-path: inset(4% round var(--hero-r));
      transform: scale(1.03);
    }
    to {
      clip-path: inset(0 round var(--hero-r));
      transform: none;
    }
  }
  @keyframes hero-float-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .hero-photo {
    --hero-r: 2rem;
  }
  @media (min-width: 64rem) {
    .hero-photo {
      --hero-r: 2.5rem;
    }
  }

  :global(html.motion) .hero-copy > * {
    animation: hero-rise 900ms var(--ease-brand) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }
  :global(html.motion) .hero-photo {
    animation: hero-unclip 1200ms var(--ease-brand) both;
  }
  :global(html.motion) .hero-card {
    animation: hero-float-in 700ms var(--ease-brand) 500ms both;
  }

  /* Parallax start state, painted from the first frame so the image does not pop when the
     motion chunk (scripts/motion/hero.ts) arrives and sets the same values. */
  @media (min-width: 64rem) {
    :global(html.motion) .hero-photo :global(img) {
      transform: scale(1.08);
      transform-origin: 50% 25%;
    }
  }
</style>
