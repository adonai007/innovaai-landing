---
interface Props {
  hero: {
    eyebrow: string;
    headlineBefore: string;
    headlineAccent: string;
    subheadline: string;
    ctaPrimary: string;
    ctaPrimaryHref: string;
    ctaSecondary: string;
    ctaSecondaryHref: string;
    note: string;
    chapter: string;
    scrollLabel: string;
  };
}

const { hero } = Astro.props;
---

<section id="hero" class="hero-section" aria-labelledby="hero-title">
  <picture class="hero-image" aria-hidden="true">
    <source
      media="(max-width: 767px)"
      srcset="/cinema/opening-mobile.webp"
      width="768"
      height="1024"
    />
    <img
      src="/cinema/opening-desktop.webp"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">
        <span>{hero.headlineBefore}</span>
        <span class="hero-accent">{hero.headlineAccent}</span>
      </h1>
      <p class="hero-subheadline">{hero.subheadline}</p>
    </div>

    <div class="hero-conversion">
      <div class="hero-actions">
        <a
          class="hero-primary"
          href={hero.ctaPrimaryHref}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="hero-whatsapp"
        >{hero.ctaPrimary}</a>
        <a class="hero-secondary" href={hero.ctaSecondaryHref} data-cta="hero-story">
          {hero.ctaSecondary}
        </a>
      </div>
      <p class="hero-note">{hero.note}</p>
    </div>

    <div class="hero-caption">
      <span>{hero.chapter}</span>
      <a href={hero.ctaSecondaryHref}>{hero.scrollLabel}<i aria-hidden="true"></i></a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    color: #f4f5ef;
    background: #071015;
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .hero-shade {
    background:
      linear-gradient(90deg, rgb(3 10 14 / 91%) 0%, rgb(3 10 14 / 70%) 28%, rgb(3 10 14 / 19%) 62%, transparent 83%),
      linear-gradient(180deg, rgb(3 10 14 / 42%) 0%, transparent 25%, transparent 64%, rgb(3 10 14 / 88%) 100%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto auto;
    align-content: end;
    min-height: max(760px, 100svh);
    width: min(100% - clamp(2.5rem, 9vw, 10rem), 1600px);
    margin: 0 auto;
    padding-top: clamp(9rem, 18svh, 13rem);
    padding-bottom: max(1.8rem, env(safe-area-inset-bottom));
  }

  .hero-copy {
    align-self: end;
    max-width: 51rem;
  }

  .hero-eyebrow {
    margin: 0 0 1.6rem;
    color: #b2d8ce;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 400;
    letter-spacing: 0.19em;
    line-height: 1.6;
  }

  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(4.4rem, 6.5vw, 7.5rem);
    font-weight: 500;
    line-height: 1.01;
    letter-spacing: -0.068em;
  }

  h1 > span {
    display: block;
  }

  .hero-accent {
    color: #a6ead1;
  }

  .hero-subheadline {
    max-width: 32rem;
    margin: 1.8rem 0 0;
    color: #d4dedd;
    font-size: clamp(1rem, 1.2vw, 1.13rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .hero-conversion {
    margin-top: 2.3rem;
    padding-bottom: clamp(3.5rem, 9svh, 6.5rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .hero-actions a {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-primary {
    padding: 0.9rem 1.4rem;
    border: 1px solid #c3f6d9;
    border-radius: 0.25rem;
    color: #06150f;
    background: #c3f6d9;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .hero-primary:hover {
    border-color: #e2ffed;
    background: #e2ffed;
  }

  .hero-actions .hero-secondary {
    padding: 0.65rem 0;
    color: #edf5f0;
    text-decoration: underline;
    text-decoration-color: rgb(237 245 240 / 35%);
    text-underline-offset: 0.45rem;
    text-decoration-thickness: 1px;
  }

  .hero-actions .hero-secondary:hover {
    text-decoration-color: currentColor;
  }

  .hero-note {
    margin: 0.95rem 0 0;
    color: #aebdb8;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .hero-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(213 235 225 / 23%);
    color: #b6c7bf;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    line-height: 1.5;
  }

  .hero-caption a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 1.1rem;
    color: inherit;
    text-decoration: none;
  }

  .hero-caption i {
    display: block;
    width: 1px;
    height: 1.5rem;
    background: #a6ead1;
  }

  @media (max-width: 767px) {
    .hero-inner {
      grid-template-rows: auto minmax(12rem, 1fr) auto;
      min-height: max(820px, 100svh);
      width: calc(100% - 2.5rem);
      padding-top: max(7.5rem, calc(env(safe-area-inset-top) + 6rem));
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
    }

    .hero-copy {
      align-self: start;
    }

    .hero-eyebrow {
      margin-bottom: 1.2rem;
      font-size: 0.56rem;
      letter-spacing: 0.14em;
    }

    h1 {
      font-size: clamp(2.4rem, 10.5vw, 4.7rem);
      line-height: 1.04;
      letter-spacing: -0.065em;
    }

    .hero-subheadline {
      max-width: 30rem;
      margin-top: 1.2rem;
      font-size: 0.87rem;
      line-height: 1.65;
    }

    .hero-image img {
      object-position: center;
    }

    .hero-shade {
      background: linear-gradient(180deg, rgb(3 10 14 / 87%) 0%, rgb(3 10 14 / 75%) 28%, rgb(3 10 14 / 8%) 49%, rgb(3 10 14 / 15%) 64%, rgb(3 10 14 / 94%) 88%, #030a0e 100%);
    }

    .hero-conversion {
      align-self: end;
      margin-top: 0;
      padding-bottom: 1.5rem;
    }

    .hero-actions {
      gap: 0.25rem 1.4rem;
    }

    .hero-actions a {
      min-height: 48px;
      font-size: 0.81rem;
    }

    .hero-primary {
      width: 100%;
    }

    .hero-note {
      margin-top: 0.35rem;
      font-size: 0.66rem;
    }

    .hero-caption {
      gap: 0.7rem;
      padding-top: 0.6rem;
      font-size: 0.49rem;
      letter-spacing: 0.07em;
    }

    .hero-caption a {
      gap: 0.5rem;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-primary {
      transition: none;
    }
  }
</style>
