---
/**
 * Dicta product card, dressed in Dicta's own brand (black and emerald) inside the InnovaAI page.
 * Default markup is the final state: full email text, pill idle, caret still. scripts/product-demos.ts
 * types the text once and blinks the caret while visible, in motion mode only. Copy states only verified
 * facts (SPEC 8.9).
 */
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import LinkArrow from './ui/LinkArrow.astro';
import dictaIcon from '../assets/brand/dicta-icon.png';
import type { DictaProduct } from '../data/types';

interface Props {
  data: DictaProduct;
}
const { data } = Astro.props;
const { mock } = data;

/** "Para: Equipo de ventas" -> label "Para:" (muted) + value (brighter), like a mail client header row. */
const splitField = (s: string) => {
  const i = s.indexOf(':');
  return i < 0 ? { label: '', value: s } : { label: s.slice(0, i + 1), value: s.slice(i + 1).trim() };
};
const rows = [splitField(mock.to), splitField(mock.subject)];
// Microcopy wraps only at its "·" separators, never inside a segment.
const metaParts = data.meta.split(' · ');
---

<article
  data-reveal
  data-dicta-card
  data-state="idle"
  class="product-card on-dark flex flex-col overflow-hidden rounded-[2rem] bg-dicta-bg"
  style="--reveal-delay:120ms"
>
  <div
    aria-hidden="true"
    data-dicta-visual
    class="relative grid aspect-[4/3] place-items-center bg-[#111111] px-6 pt-6 pb-16 select-none sm:aspect-[16/10] sm:pb-14"
  >
    <div class="w-full max-w-[440px] overflow-hidden rounded-2xl bg-dicta-surface text-ui shadow-window-dark">
      <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
        <Icon name="envelope-simple" class="size-4 text-white/60" />
        <span class="font-semibold text-white/85">{mock.windowTitle}</span>
      </div>
      {
        rows.map((r) => (
          <p class="truncate border-b border-white/10 px-4 py-2 text-white/60">
            {r.label && <span>{r.label} </span>}
            <span class="text-white/85">{r.value}</span>
          </p>
        ))
      }
      <div class="min-h-[96px] px-4 py-3 text-[14px] leading-relaxed text-white/90">
        {/* Ghost copy reserves the final height, so the window never grows while the text types itself. */}
        <div class="grid">
          <span class="invisible [grid-area:1/1]">{mock.text}<span class="ml-0.5 inline-block w-0.5"></span></span>
          <span class="[grid-area:1/1]"
            ><span data-typed>{mock.text}</span><span
              data-caret
              class="ml-0.5 inline-block h-[1.1em] w-0.5 translate-y-[3px] bg-dicta-green"></span
            ></span
          >
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-4 left-1/2 inline-flex -translate-x-1/2 items-center gap-2 rounded-full bg-[#1a1a1a] px-3 py-1.5 text-xs whitespace-nowrap text-white/85 ring-1 ring-white/10"
    >
      <span data-pill-dot class="size-2 shrink-0 rounded-full"></span>
      <span class="pill-label">
        <span data-pill class="pill-idle">{mock.pillIdle}</span>
        <span class="pill-listening">{mock.pillListening}</span>
      </span>
    </div>
  </div>

  <div class="product-body flex flex-1 flex-col p-6 sm:p-8 lg:p-10">
    <p class="flex items-center gap-3" aria-hidden="true">
      <Image src={dictaIcon} alt="" width={40} height={40} densities={[1, 2]} class="size-10 shrink-0" />
      <span class="font-display text-2xl leading-none font-semibold tracking-tight text-white">Dicta</span>
    </p>
    <p class="mt-6 font-display text-sm font-medium text-dicta-green">{data.eyebrow}</p>
    <h3 class="mt-2 text-h3-lg font-semibold text-white"><span class="sr-only">{data.name}. </span>{data.tagline}</h3>
    <p class="mt-4 max-w-[34rem] text-white/70">{data.body}</p>
    <div>
      <ul class="mt-6 grid gap-3">
        {
          data.bullets.map((b) => (
            <li class="flex gap-3">
              <Icon name="check" class="mt-0.5 size-5 shrink-0 text-dicta-green" />
              <span class="text-white/85">{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-white/60">{metaParts.map((part, i) => <Fragment>{i > 0 && '\u00a0· '}<span class="whitespace-nowrap">{part}</span></Fragment>)}</p>
    </div>
    <div class="mt-auto pt-8">
      <LinkArrow href={data.cta.href} label={data.cta.label} icon="arrow-up-right" external hint={data.cta.srHint} />
    </div>
  </div>
</article>

<style>
  /* Pill: both labels stacked in one cell, so the pill keeps its width when the state swaps. */
  .pill-label {
    display: inline-grid;
  }
  .pill-label > span {
    grid-area: 1 / 1;
    transition: opacity 300ms var(--ease-brand);
  }
  .pill-listening {
    opacity: 0;
  }
  [data-state='listening'] .pill-idle {
    opacity: 0;
  }
  [data-state='listening'] .pill-listening {
    opacity: 1;
  }
  [data-pill-dot] {
    background: rgb(255 255 255 / 0.4);
    transition: background-color 300ms var(--ease-brand);
  }
  [data-state='listening'] [data-pill-dot] {
    background: var(--color-dicta-green);
  }

  /* Motion mode only: the dot pulses while listening; the caret blinks a few times once the card is on
     screen and idle, then stays still (no endless motion, WCAG 2.2.2). */
  :global(html.motion) [data-state='listening'] [data-pill-dot] {
    animation: dicta-pulse 1.2s var(--ease-brand) infinite;
  }
  :global(html.motion) .is-live[data-state='idle'] [data-caret] {
    animation: dicta-blink 1s steps(1) 4;
  }
  @keyframes dicta-pulse {
    50% {
      opacity: 0.45;
    }
  }
  @keyframes dicta-blink {
    50% {
      opacity: 0;
    }
  }
</style>
