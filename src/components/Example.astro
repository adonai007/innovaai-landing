---
/**
 * Ejemplo: one sticky, scroll-scrubbed "Bandeja de operaciones" demo (SPEC §4.2).
 * Default markup = final static state in normal flow (no JS, reduced motion, Save-Data, or before the
 * motion chunk arrives). scripts/motion/example.ts adds .is-ready to the track, which turns it into a
 * tall track with a sticky 100lvh stage, and renders every state from scroll progress.
 * Nothing inside the stage uses data-reveal, and no ancestor of the stage may clip overflow.
 */
import SectionHead from './ui/SectionHead.astro';
import OpsInbox from './OpsInbox.astro';
import type { ExampleData } from '../data/types';

interface Props {
  data: ExampleData;
}
const { data } = Astro.props;
---

<section id="ejemplo" class="on-dark bg-night" aria-labelledby="ejemplo-title">
  <div class="wrap pt-24 lg:pt-32">
    <SectionHead head={data.head} titleId="ejemplo-title" />
  </div>

  <div data-story="example" class="ex-track">
    <div class="ex-stage">
      <div class="ex-grid wrap">
        <div class="ex-steps" data-ex-steps>
          <span class="ex-rail" aria-hidden="true"><span class="ex-rail-fill"></span></span>
          <ol class="ex-list">
            {
              data.steps.map((step) => (
                <li data-ex-step class="ex-step">
                  <span class="font-display text-sm font-semibold text-teal tabular-nums" aria-hidden="true">
                    {step.number}
                  </span>
                  <h3 class="mt-1 text-xl font-semibold tracking-tight">{step.title}</h3>
                  <div class="ex-step-body">
                    <p class="text-white/70">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="ex-window">
          <OpsInbox inbox={data.inbox} />
        </div>

        <div class="ex-dots" aria-hidden="true">
          {data.steps.map(() => <span data-ex-dot class="ex-dot size-1.5 rounded-full bg-white/25" />)}
        </div>
      </div>
    </div>
  </div>

  <div class="ex-after wrap pb-24 lg:pb-32">
    <p class="mt-10 text-sm text-white/60">{data.caption}</p>
  </div>
  <p class="sr-only">{data.srSummary}</p>
</section>

<style>
  /* ---------- static layout: final state in normal flow ---------- */
  .ex-stage {
    padding-block: 4rem;
  }
  .ex-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .ex-window {
    order: -1;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }
  .ex-steps {
    position: relative;
  }
  .ex-list {
    display: grid;
    gap: 2rem;
  }
  .ex-step-body {
    display: grid;
    grid-template-rows: 1fr;
  }
  .ex-step-body > p {
    min-height: 0;
    overflow: hidden;
    padding-top: 0.5rem;
  }
  .ex-rail,
  .ex-dots {
    display: none;
  }
  @media (min-width: 640px) {
    .ex-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .ex-grid {
      display: grid;
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
    .ex-window {
      order: 0;
      justify-self: end;
      max-width: 680px;
      margin-inline: 0;
    }
    .ex-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .ex-grid {
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  /* ---------- ready: tall track, sticky 100lvh stage, scrubbed by the timeline ---------- */
  :global(html.motion) .ex-track:global(.is-ready) {
    height: 280svh;
  }
  :global(html.motion) .ex-track:global(.is-ready) .ex-stage {
    position: sticky;
    top: 0;
    height: 100lvh;
    padding-block: 0;
  }
  :global(html.motion) .ex-track:global(.is-ready) .ex-grid {
    height: 100%;
  }
  @media (max-width: 1023px) {
    /* lay the column out in the small viewport, so a visible browser toolbar never covers the step or the dots */
    :global(html.motion) .ex-track:global(.is-ready) .ex-grid {
      height: 100svh;
      gap: 1.25rem;
      padding-top: 76px;
      padding-bottom: 1.5rem;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-list {
      display: block;
    }
    /* inactive steps leave the layout but stay in the accessibility tree (headings do not come and go) */
    :global(html.motion) .ex-track:global(.is-ready) .ex-step:not([aria-current]) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-step[aria-current] {
      animation: ex-step-in 500ms var(--ease-brand) both;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
    }
  }
  :global(html.motion) .ex-track:global(.is-ready) .ex-dot {
    transition:
      background-color 400ms var(--ease-brand),
      width 400ms var(--ease-brand);
  }
  :global(html.motion) .ex-track:global(.is-ready) .ex-dot:global(.is-active) {
    width: 1rem;
    background: var(--color-teal);
  }
  @keyframes ex-step-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  /* tablets: center the column in the stage (below the pill), and pull the caption up over the empty
     lower band the pinned stage leaves behind when the track ends */
  @media (min-width: 640px) and (max-width: 1023px) {
    :global(html.motion) .ex-track:global(.is-ready) .ex-grid {
      justify-content: center;
    }
    :global(html.motion) .ex-track:global(.is-ready) + .ex-after {
      margin-top: calc(-1 * clamp(0rem, (100lvh - 880px) / 2, 6rem));
    }
  }
  /* short phones: the step keeps its title only (OpsInbox also switches to a denser window below 860px) */
  @media (max-width: 1023px) and (max-height: 740px) {
    :global(html.motion) .ex-track:global(.is-ready) .ex-step-body {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    /* the track starts under the end of the intro, so the window arrives with the heading instead of
       after an empty band (the stage is transparent and the window sits well below the intro) */
    :global(html.motion) .ex-track:global(.is-ready) {
      height: 320svh;
      margin-top: calc(-1 * clamp(0rem, (100lvh - 640px) / 2, 7.5rem));
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-grid {
      padding-top: 5rem;
    }
    /* The sticky stage centres the window in 100lvh, so its lower half is empty when the track ends: pull the caption up. */
    :global(html.motion) .ex-track:global(.is-ready) + .ex-after {
      margin-top: calc(-1 * clamp(0rem, (100lvh - 640px) / 2, 5rem));
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-list {
      gap: 1.5rem;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-step {
      padding-left: 2rem;
      transition: opacity 500ms var(--ease-brand);
    }
    /* 0.6 keeps inactive titles at white/60 (7:1 on night), the minimum for text on dark */
    :global(html.motion) .ex-track:global(.is-ready) .ex-step:not([aria-current]) {
      opacity: 0.6;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-step-body {
      transition: grid-template-rows 500ms var(--ease-brand);
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-step:not([aria-current]) .ex-step-body {
      grid-template-rows: 0fr;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-rail {
      display: block;
      position: absolute;
      top: 0.25rem;
      bottom: 0.25rem;
      left: 0;
      width: 2px;
      border-radius: 2px;
      background: rgb(255 255 255 / 0.1);
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-rail-fill {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--gradient-logo-v);
      transform-origin: top;
      transform: scaleY(var(--p, 1));
    }
  }

  /* print: the whole demo in normal flow, every step readable (example.ts renders the final state on beforeprint) */
  @media print {
    :global(html.motion) .ex-track:global(.is-ready) {
      height: auto;
      margin-top: 0;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-stage {
      position: static;
      height: auto;
      padding-block: 2rem;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-grid {
      height: auto;
      padding-block: 0;
    }
    /* :is() matches the specificity of the hiding rules above, so these win by order */
    :global(html.motion) .ex-track:global(.is-ready) .ex-step:is([aria-current], :not([aria-current])) {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      opacity: 1;
      animation: none;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-step:is([aria-current], :not([aria-current])) .ex-step-body {
      display: grid;
      grid-template-rows: 1fr;
    }
    :global(html.motion) .ex-track:global(.is-ready) .ex-rail,
    :global(html.motion) .ex-track:global(.is-ready) .ex-dots {
      display: none;
    }
    :global(html.motion) .ex-track:global(.is-ready) + .ex-after {
      margin-top: 0;
    }
    .ex-window > :global([data-ex-window]) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
