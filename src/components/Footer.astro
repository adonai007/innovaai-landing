---
/**
 * Apple-style footer on #f5f5f7, 12px grey: tagline, hairline, logo breadcrumb, a three-column directory
 * (two columns below 735px), hairline, then copyright and location on the left and the language link on the right.
 */
import Logo from './ui/Logo.astro';
import type { FooterData, SiteData } from '../data/types';

interface Props {
  data: FooterData;
  site: SiteData;
}
const { data, site } = Astro.props;
const copyright = data.copyright.replace('{year}', String(new Date().getFullYear()));
---

<footer class="bg-canvas-alt text-legal text-ink-2">
  <div class="wrap-text pt-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
    <p>{data.tagline}</p>
    <hr class="mt-3 border-0 border-t border-hairline" />

    <div class="py-3">
      <a href="#top" class="footer-home inline-flex min-h-6 items-center text-ink">
        <Logo size="footer" />
      </a>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-5 pt-1 md:grid-cols-3">
      {
        data.columns.map((col) => (
          <div>
            <h2 class="font-semibold text-ink">{col.title}</h2>
            <ul class="mt-2">
              {col.links.map((link) => (
                <li class="min-h-6 py-0.5">
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    hreflang={link.hreflang}
                    lang={link.hreflang}
                    class="footer-link text-[#424245] hover:underline"
                  >
                    {link.label}
                    {link.external && <span class="sr-only"> {link.srHint ?? site.externalHint}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <hr class="mt-6 border-0 border-t border-hairline" />
    <div class="flex flex-col gap-y-1 pt-3 md:flex-row md:flex-wrap md:items-baseline md:gap-x-4">
      <p>{copyright}</p>
      <p>{data.location}</p>
      <a
        href={data.lang.href}
        hreflang={data.lang.hreflang}
        lang={data.lang.hreflang}
        class="mt-2 self-start text-[#424245] hover:underline md:mt-0 md:ml-auto"
      >
        {data.lang.label}
      </a>
    </div>
  </div>
</footer>
