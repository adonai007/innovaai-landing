---
/** Night footer: lockup + tagline, three link columns, legal row and a giant low-contrast colophon. */
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import type { FooterData, SiteData } from '../data/types';

interface Props {
  data: FooterData;
  site: SiteData;
}
const { data, site } = Astro.props;
const legal = data.legal.replace('{year}', String(new Date().getFullYear()));
---

<footer class="on-dark overflow-hidden border-t border-white/10 bg-night">
  <div class="wrap pt-16 pb-10">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <Logo size="md" />
        <p class="mt-4 max-w-[22rem] text-sm text-white/70">{data.tagline}</p>
      </div>
      {
        data.columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="font-display text-sm font-medium text-white">{col.title}</h2>
            <ul class="mt-2 grid text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    hreflang={link.hreflang}
                    lang={link.hreflang}
                    class="inline-flex min-h-10 items-center rounded-sm text-white/70 transition-[color,background-color] duration-300 ease-brand hover:text-white"
                  >
                    {link.label}
                    {link.external && (
                      <>
                        <Icon name="arrow-up-right" class="ml-1 inline size-3.5" />
                        <span class="sr-only"> {site.externalHint}</span>
                      </>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex-row sm:justify-between">
      <p>{legal}</p>
      <p>{data.demoNote}</p>
    </div>
  </div>
  <p
    aria-hidden="true"
    class="pointer-events-none select-none text-center font-display text-[19vw] leading-[0.8] font-semibold tracking-tight whitespace-nowrap text-white/[0.05]"
  >
    {data.colophon}
  </p>
</footer>
