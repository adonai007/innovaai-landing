---
/**
 * STUB (phase 1 foundation). Phase 2 replaces this with the film chapter (SPEC2 4.5).
 * No data-cinema here, so scripts/cinema.ts stays inert. The previous component is in git history (HEAD).
 */
import type { CinemaData } from '../data/types';

interface Props {
  data: CinemaData;
}
const { data } = Astro.props;
---

<section id="historia" aria-labelledby="historia-title" data-nav-theme="dark" class="cinema section on-night seam">
  <div class="wrap-text text-center">
    <h2 id="historia-title" class="text-display">{data.label}</h2>
  </div>
</section>
