---
/**
 * #dentimed: the first fold. DentiMed's product lockup (icon and name, headline, subhead, meta line, two pills)
 * over two HTML phones built from DentiMed's own app UI: Dictado (left, lower, from 735px) and Borrador. The lockup
 * is kept tight (one-line subhead, a shorter meta line on phones) so the phones take a real share of the fold.
 * Motion: under html.motion the phones rise once on load; every other mode shows the static final state.
 */
import Button from '../ui/Button.astro';
import Lines from '../ui/Lines.astro';
import MetaLine from '../ui/MetaLine.astro';
import DentimedPhone from './DentimedPhone.astro';
import dmIconRaw from '../../assets/brand/dentimed-icon.svg?raw';
import type { DentimedData } from '../../data/types';

interface Props {
  data: DentimedData;
}
const { data } = Astro.props;
const { lockup, primary, demo } = data;
// DentiMed's real icon, inlined so the first fold requests no image
const dmIcon = dmIconRaw.replace('<svg ', '<svg class="dm-icon" aria-hidden="true" focusable="false" ');
---

<section
  id="dentimed"
  aria-labelledby="dentimed-title"
  class="overflow-clip bg-canvas-alt pt-[var(--tile-pad)] pb-[var(--section-pad)]"
>
  <div class="wrap-text text-center">
    <h2 id="dentimed-title" class="flex items-center justify-center gap-2.5 text-eyebrow">
      <span class="size-7 shrink-0 md:size-9" set:html={dmIcon} />
      {lockup.name}
    </h2>
    <p class="mt-2 text-hero text-balance"><Lines text={lockup.title} /></p>
    <p class="mx-auto mt-3 max-w-[40rem] text-subhead text-balance md:mt-4 md:max-w-none lg:max-w-[46rem]">{lockup.subhead}</p>
    <MetaLine class="mt-3 text-ink-2" text={lockup.meta} small={lockup.metaSmall} />
    <div class="mt-5 flex flex-wrap justify-center gap-3 md:mt-6 md:gap-4">
      <Button size="auto" variant="primary" href={primary.href} label={primary.label} external hint={primary.srHint} />
      <Button size="auto" variant="secondary" href={demo.href} label={demo.label} external hint={demo.srHint} />
    </div>
  </div>

  {/* the label follows the page language; lang="es" marks only the Spanish app UI inside */}
  <figure class="dm-phones mt-10 md:mt-12" role="img" aria-label={data.phonesLabel}>
    <div class="dm-phones-row" aria-hidden="true" lang="es">
      <DentimedPhone screen="dictado" class="dm-phone-left hidden md:block" />
      <DentimedPhone screen="borrador" />
    </div>
  </figure>
</section>

<style>
  :global(.dm-icon) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dm-phones {
    --phone-w: 16.5rem;
  }
  .dm-phones-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 2rem;
  }
  @media (min-width: 45.9375em) {
    .dm-phones {
      --phone-w: 16.25rem;
      /* room for the lower left phone, so the tile's bottom padding stays even */
      padding-bottom: 2.5rem;
    }
  }
  @media (min-width: 66.8125em) {
    .dm-phones {
      --phone-w: 18.75rem;
    }
    .dm-phones-row {
      gap: 3rem;
    }
  }
  .dm-phones-row > :global(.dm-phone-left) {
    transform: translateY(2.5rem);
  }

  /* one rise on load, motion mode only */
  :global(html.motion) .dm-phones {
    animation: dm-rise 900ms var(--ease-out) 150ms both;
  }
  @keyframes dm-rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
