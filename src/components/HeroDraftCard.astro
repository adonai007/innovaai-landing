---
/**
 * Hero draft card: a white mock of an AI-prepared order with a real Approve / Undo interaction.
 * It is a labelled group, not aria-hidden. Without JS the actions stay inert and look identical.
 * Behaviour lives in scripts/hero-card.ts; the strings it needs travel as data attributes.
 */
import Icon from './ui/Icon.astro';
import type { HeroData } from '../data/types';

interface Props {
  draft: HeroData['draft'];
}
const { draft } = Astro.props;
---

<div
  data-draft-card
  data-state="draft"
  data-status-draft={draft.statusDraft}
  data-status-approved={draft.statusApproved}
  data-approved-note={draft.approvedNote}
  role="group"
  aria-label={draft.ariaLabel}
  class="rounded-2xl bg-white p-4 text-ui text-ink shadow-float"
>
  <div class="flex items-center justify-between gap-3">
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-action">
      <Icon name="sparkle" weight="fill" class="size-4 text-electric" />{draft.badge}
    </span>
    <span class="chip chip-draft" data-chip>{draft.statusDraft}</span>
  </div>
  <p class="mt-2 font-display text-[17px] leading-snug font-semibold">{draft.title}</p>
  <p class="mt-1 inline-flex items-center gap-1.5 text-xs text-muted tabular-nums">
    <Icon name="microphone" class="size-3.5 shrink-0" />{draft.source}
  </p>
  <dl class="mt-3 divide-y divide-line border-y border-line">
    {
      draft.fields.map((field) => (
        <div class="grid grid-cols-[96px_1fr] gap-3 py-2">
          <dt class="text-muted">{field.label}</dt>
          <dd class="font-medium">
            <span class="field-value -mx-1 box-decoration-clone rounded bg-sky px-1">{field.value}</span>
          </dd>
        </div>
      ))
    }
  </dl>
  <div data-actions inert class="mt-3 flex min-h-8 items-center justify-end gap-3">
    <button type="button" data-undo hidden class="hit hit-text text-xs font-semibold text-action underline underline-offset-4">
      {draft.undo}
    </button>
    <span data-approved hidden class="inline-flex items-center gap-1 text-xs font-semibold text-ok">
      <Icon name="check" class="size-4" />{draft.approved}
    </span>
    <button
      type="button"
      data-approve
      class="hit rounded-full bg-ink px-3.5 py-1.5 text-xs font-semibold text-white transition-[background-color] duration-300 ease-brand hover:bg-night"
    >
      {draft.approve}
    </button>
  </div>
  <p data-note class="sr-only" aria-live="polite"></p>
</div>

<style>
  /* Touch targets reach 40px without changing the drawn size of the small mock buttons. */
  .hit {
    position: relative;
  }
  .hit::before {
    content: '';
    position: absolute;
    inset: -6px -4px;
  }
  .hit-text::before {
    inset: -12px -6px;
  }

  /* The 300ms swap (motion only). Chip and highlights ease; the shown actions rise in. */
  @keyframes hero-swap-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  :global(html.motion) [data-chip],
  :global(html.motion) .field-value {
    transition:
      background-color 300ms var(--ease-brand),
      color 300ms var(--ease-brand);
  }
  :global(html.motion) [data-actions] > :not([hidden]) {
    animation: hero-swap-in 300ms var(--ease-brand) both;
  }

  /* Once a person approves, the AI-filled highlights settle into plain text. */
  [data-state='approved'] .field-value {
    background-color: transparent;
  }
</style>
