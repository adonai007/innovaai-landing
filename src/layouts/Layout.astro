---
/**
 * Base document: meta, Open Graph, hreflang, canonical, the JSON-LD @graph (Organization, WebSite, WebPage plus
 * the page's own nodes) and the inline mode script.
 *
 * Mode script (runs before first paint): swaps no-js for js, adds motion or still (reduced motion or Save-Data)
 * and slow-net on 2G. Fonts: Apple devices get html.sf and render SF Pro from the system stack (no download);
 * everywhere else it preloads the one Inter latin opsz file that global.css declares.
 */
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
  skipLink: string;
  organizationDescription: string;
  /** site-relative path of this locale's share card (also the Organization image on this page) */
  ogImage?: string;
  ogImageAlt: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  lang = 'es',
  skipLink,
  organizationDescription,
  ogImage = '/images/innovaai-og.jpg',
  ogImageAlt,
  structuredData = [],
} = Astro.props;
const altLang = lang === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname;
const altPath = currentPath.replace(`/${lang}`, `/${altLang}`);
const canonicalURL = new URL(currentPath, Astro.site ?? 'https://innovai.click');
const altURL = new URL(altPath, Astro.site ?? 'https://innovai.click');
const defaultURL = new URL(currentPath.replace(`/${lang}`, '/es'), Astro.site ?? 'https://innovai.click');
const siteURL = new URL('/', Astro.site ?? 'https://innovai.click');
// the square mark tile (the same one the nav and favicons use), not the retired v1 banner
const logoURL = new URL('/images/innovaai-logo-mark-192.png', siteURL);
const ogImageURL = new URL(ogImage, siteURL);
const organizationId = `${siteURL.href}#organization`;
const websiteId = `${siteURL.href}#website`;
const webpageId = `${canonicalURL.href}#webpage`;
const ogLocale = lang === 'es' ? 'es_LA' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_LA';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'InnovaAI',
      alternateName: 'Innova AI',
      legalName: 'InnovaAI SRL',
      url: siteURL.href,
      logo: {
        '@type': 'ImageObject',
        url: logoURL.href,
        contentUrl: logoURL.href,
        width: 192,
        height: 192,
      },
      image: {
        '@type': 'ImageObject',
        url: ogImageURL.href,
        contentUrl: ogImageURL.href,
        width: 1200,
        height: 630,
      },
      description: organizationDescription,
      sameAs: ['https://www.linkedin.com/company/innovai-click/'],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'La Paz',
        addressCountry: 'BO',
      },
      areaServed: 'Worldwide',
      founder: {
        '@type': 'Person',
        name: 'Adonai Callejas',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+59172004767',
        contactType: 'sales',
        availableLanguage: ['Spanish', 'English'],
      },
      knowsLanguage: ['Spanish', 'English'],
      knowsAbout: [
        'AI product design',
        'software development',
        'voice dictation',
        'dental clinic software',
        'workflow automation',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'InnovaAI',
      alternateName: 'Innova AI',
      url: siteURL.href,
      publisher: { '@id': organizationId },
      inLanguage: ['es', 'en'],
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalURL.href,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': organizationId },
      mainEntity: { '@id': organizationId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageURL.href,
        contentUrl: ogImageURL.href,
        width: 1200,
        height: 630,
      },
      inLanguage: lang,
    },
    ...structuredData,
  ],
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline define:vars={{ interUrl: interLatin }}>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var c = navigator.connection;
        var sd = c && c.saveData;
        d.classList.add(rm || sd ? 'still' : 'motion');
        // 2G: the film chapter never builds its tall tracks (no layout shift when its script arrives late)
        if (c && /(^|-)2g$/.test(c.effectiveType || '')) d.classList.add('slow-net');
        // Apple devices render SF Pro from the system stack and download no font; everyone else gets Inter
        var uad = navigator.userAgentData;
        var platform = (uad && uad.platform) || navigator.platform || '';
        if (/Mac|iPhone|iPad|iPod|macOS/.test(platform)) d.classList.add('sf');
        else {
          var l = document.createElement('link');
          l.rel = 'preload';
          l.as = 'font';
          l.type = 'font/woff2';
          l.crossOrigin = 'anonymous';
          l.href = interUrl;
          document.head.appendChild(l);
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="author" content="InnovaAI" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/innovaai-logo-mark-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/innovaai-logo-mark-192.png" />
    <link rel="apple-touch-icon" href="/images/innovaai-logo-mark-192.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={lang} href={canonicalURL.href} />
    <link rel="alternate" hreflang={altLang} href={altURL.href} />
    <link rel="alternate" hreflang="x-default" href={defaultURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="InnovaAI" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <title>{title}</title>
  </head>
  <body id="top">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-caption focus:text-ink focus:ring-2 focus:ring-action focus:outline-hidden"
      >{skipLink}</a
    >
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
